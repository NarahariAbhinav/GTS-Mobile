{
  "expo": {
    "name": "GTS",
    "slug": "GTS",
    "owner": "abhinav031",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/GTS_Logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/GTS_Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GTS to access your camera to scan garment barcodes."
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/messaging"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abhinav031.GTS",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/GTS_Logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.skil01.Gts",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fe74aaab-311f-4e36-93de-2508f0846d96"
      }
    }
  }
}
